# Copy to .env. Every setting is optional; the defaults run offline.

# --- LLM provider ------------------------------------------------------------
# `auto` uses the first provider whose credentials actually resolve, and falls
# back to the deterministic engine when none do. Name one to pin it:
#   anthropic bedrock vertex openai azure google groq together openrouter
#   deepseek mistral ollama vllm offline
# `creditlens providers` shows which are usable from your machine.
CREDITLENS_LLM_PROVIDER=auto
# Leave empty to use the selected provider's default model.
CREDITLENS_MODEL=
CREDITLENS_MAX_TOKENS=8000

# Anthropic-only knobs; ignored by other providers.
CREDITLENS_EFFORT=high
CREDITLENS_THINKING=true

# --- provider credentials ----------------------------------------------------
# Set whichever you use. For Anthropic an unset key is not proof of no
# credentials: the SDK also resolves ANTHROPIC_AUTH_TOKEN and `ant auth login`
# profiles, so construction is attempted and failure is what triggers fallback.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=...
# OPENROUTER_API_KEY=...
# DEEPSEEK_API_KEY=...
# MISTRAL_API_KEY=...
# AZURE_OPENAI_API_KEY=...   # plus AZURE_OPENAI_ENDPOINT
# Local servers need no key; they are detected by probing the endpoint:
#   ollama   http://localhost:11434/v1
#   vllm     CREDITLENS_VLLM_BASE_URL=http://localhost:8000/v1

# Anthropic on a cloud provider:
# CREDITLENS_AWS_REGION=us-east-1
# CREDITLENS_GCP_PROJECT=my-project
# CREDITLENS_GCP_REGION=global

# --- token pricing -----------------------------------------------------------
# Anthropic rates ship built in. Any other model reports
# `cost_basis: "no rate configured"` rather than a made-up $0.00 until you set
# a rate here, as `model=input_per_mtok/output_per_mtok`.
# CREDITLENS_MODEL_PRICES=gpt-5=1.25/10,llama-3.3-70b=0.6/0.6

# --- agent budgets ---------------------------------------------------------
CREDITLENS_MAX_TOOL_ITERATIONS=8
CREDITLENS_MAX_TOOL_CALLS=24

# --- retrieval (defaults set by scripts/sweep_retrieval.py) ----------------
CREDITLENS_RETRIEVAL_TOP_K=8
CREDITLENS_DENSE_WEIGHT=0.2
CREDITLENS_RETRIEVAL_USE_MMR=false
CREDITLENS_EMBEDDING_DIM=512

# --- verification ----------------------------------------------------------
CREDITLENS_NUMERIC_TOLERANCE_PCT=0.5

# --- storage ---------------------------------------------------------------
# Defaults to SQLite under ./data. Postgres works unchanged:
# CREDITLENS_DATABASE_URL=postgresql+psycopg://creditlens:creditlens@localhost:5432/creditlens

# --- SEC EDGAR -------------------------------------------------------------
# The SEC requires a descriptive User-Agent with a contact address.
CREDITLENS_EDGAR_USER_AGENT=CreditLens/0.1 (you@example.com)

# --- api -------------------------------------------------------------------
CREDITLENS_API_PORT=8000
CREDITLENS_LOG_LEVEL=INFO
CREDITLENS_LOG_FORMAT=json
